; BioSeg twin: one servo over yellow and red, white and blue reached by hand after a hold.
config_version=5

[application]
config/name="BioSeg Twin"
run/main_scene="res://scenes/rig.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
anti_aliasing/quality/msaa_3d=2
